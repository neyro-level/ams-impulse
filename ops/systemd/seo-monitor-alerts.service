[Unit]
Description=AMS IMPULSE owner-critical alert check
After=network-online.target seo-monitor-web.service seo-monitor-worker.service
Wants=network-online.target
ConditionPathExists=/etc/ams-platform/ams-seo-monitor-alerts.env

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ams-impulse-owner-alerts.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ams-platform/ams-seo-monitor/alerts
TimeoutStartSec=45s
