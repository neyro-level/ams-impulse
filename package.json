{
  "name": "ams-impulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.5.1 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:status": "node --env-file=.env.local scripts/local-dev.mjs status",
    "dev:start": "node --env-file=.env.local scripts/local-dev.mjs start",
    "start": "node .next/standalone/server.js",
    "build": "pnpm prisma:generate && pnpm verify:config && next build && node scripts/prepare-standalone.mjs",
    "build:collector": "pnpm prisma:generate && tsc -p tsconfig.collector.json",
    "release:build": "node scripts/verify-release-runtime.mjs && pnpm build && pnpm build:collector && node scripts/build-release.mjs",
    "release:deploy": "node scripts/deploy-production.mjs",
    "lint": "eslint src collector tests scripts eslint.config.mjs next.config.ts playwright.config.ts vitest.config.mts vitest.integration.config.mts postcss.config.mjs",
    "typecheck": "pnpm prisma:generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.collector.json && tsc --noEmit -p tsconfig.tests.json",
    "architecture:check": "depcruise src collector --config dependency-cruiser.config.cjs --output-type err-long && node scripts/verify-architecture.mjs",
    "risk:classify": "tsx scripts/risk-classify.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:security": "node scripts/run-integration-tests.mjs tests/auth.authorization.test.ts tests/auth-rate-limit.integration.test.ts tests/notification-rls.integration.test.ts tests/platform-admin-adoption.integration.test.ts tests/principal.integration.test.ts tests/tenant-ownership.integration.test.ts tests/tenant-constraints.integration.test.ts",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test",
    "playwright:install": "playwright install chromium",
    "verify:quick": "pnpm verify:config && pnpm verify:migrations && pnpm typecheck && pnpm lint && pnpm architecture:check",
    "verify:risky": "pnpm verify:quick && pnpm test:unit && pnpm test:security && pnpm verify:datetime-contract && pnpm build",
    "verify:daily": "pnpm verify:quick && pnpm test:unit && pnpm test:integration && pnpm verify:rls-coverage && pnpm verify:datetime-contract && pnpm verify:database-runtime && pnpm build && pnpm test:e2e:run && pnpm security:semgrep && pnpm security:dependencies",
    "verify:release": "pnpm verify:daily && pnpm verify:database-runtime && pnpm verify:snapshots && node scripts/verify-release-runtime.mjs && pnpm build:collector",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:bootstrap": "tsx scripts/seed-bootstrap.ts",
    "config:sync": "tsx scripts/config-sync.ts",
    "pgboss:migrate": "node --env-file-if-exists=.env.local scripts/pgboss-migrate.mjs",
    "dev:db:start": "node --env-file=.env.local scripts/local-postgres.mjs start",
    "dev:db:stop": "node --env-file=.env.local scripts/local-postgres.mjs stop",
    "dev:db:status": "node --env-file=.env.local scripts/local-postgres.mjs status",
    "dev:db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.local scripts/pgboss-migrate.mjs",
    "dev:db:bootstrap": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-bootstrap.ts",
    "user:create": "tsx scripts/auth-admin.ts create",
    "user:reset-password": "tsx scripts/auth-admin.ts reset-password",
    "user:disable": "tsx scripts/auth-admin.ts disable",
    "user:set-system-role": "tsx scripts/auth-admin.ts set-system-role",
    "platform-admin:bootstrap": "tsx scripts/auth-admin.ts bootstrap-platform-admin",
    "platform-admin:verify-bootstrap": "tsx scripts/auth-admin.ts verify-platform-admin-bootstrap",
    "platform-admin:adopt-legacy": "tsx scripts/auth-admin.ts adopt-legacy-platform-admin",
    "platform-admin:verify-adoption": "tsx scripts/auth-admin.ts verify-platform-admin-adoption",
    "platform-admin:recover": "tsx scripts/auth-admin.ts recover-platform-admin",
    "platform-admin:verify-recovery": "tsx scripts/auth-admin.ts verify-platform-admin-recovery",
    "user:add-to-organization": "tsx scripts/auth-admin.ts add-to-organization",
    "user:remove-from-organization": "tsx scripts/auth-admin.ts remove-from-organization",
    "verify:config": "pnpm verify:public-data && pnpm verify:ui && node scripts/verify-config.mjs && node scripts/verify-environment-registry.mjs",
    "verify:environment": "node scripts/verify-environment-registry.mjs",
    "verify:ui": "node scripts/verify-ui-conformance.mjs && node scripts/verify-ui-theme.mjs",
    "verify:public-data": "node scripts/verify-public-data.mjs",
    "verify:web-environment": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-web-environment.ts",
    "verify:snapshots": "node scripts/verify-snapshots.mjs",
    "verify:tenant-ownership": "node --env-file-if-exists=.env.local scripts/verify-tenant-ownership.mjs",
    "verify:rls-coverage": "tsx --env-file-if-exists=.env.local scripts/verify-rls-coverage.ts",
    "verify:datetime-contract": "node scripts/verify-datetime-contract.mjs",
    "verify:database-runtime": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/verify-database-runtime-contract.ts",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "security:semgrep:rules": "node scripts/verify-semgrep-rules.mjs",
    "security:semgrep": "pnpm security:semgrep:rules && semgrep scan --metrics off --jobs 1 --config .semgrep.yml --exclude node_modules --exclude .next --exclude out --exclude dist-collector --exclude src/generated --exclude tests --exclude test-results --exclude playwright-report --exclude docs/archive --exclude fixtures --exclude snapshots --exclude src/components/marketing/legal/legal-html.ts",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "project:add": "node scripts/project-add.mjs",
    "collector:webmaster:preflight": "pnpm build:collector && node dist-collector/collector/main.js webmaster-preflight",
    "collector:webmaster:audit": "pnpm build:collector && node dist-collector/collector/main.js webmaster-audit",
    "collector:metrica:preflight": "pnpm build:collector && node dist-collector/collector/main.js metrica-preflight",
    "worker:sync:project": "pnpm build:collector && node dist-collector/src/worker/main.js project-sync",
    "worker:sync:all": "pnpm build:collector && node dist-collector/src/worker/main.js projects-sync daily",
    "worker:topvisor:checks": "pnpm build:collector && node dist-collector/src/worker/main.js topvisor-checks",
    "worker:sync:competitors": "pnpm build:collector && node dist-collector/src/worker/main.js competitors-sync",
    "worker:outbox:drain": "pnpm build:collector && node dist-collector/src/worker/main.js outbox-drain",
    "worker:outbox:retention": "pnpm build:collector && node dist-collector/src/worker/main.js outbox-retention",
    "worker:research:run": "pnpm build:collector && node dist-collector/src/worker/main.js research-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1125.0",
    "@aws-sdk/s3-request-presigner": "3.1125.0",
    "@base-ui/react": "1.8.0",
    "@better-auth/cimd": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/prisma-adapter": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@fontsource/manrope": "5.2.8",
    "@hookform/resolvers": "5.9.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "9.2.4",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "nuqs": "2.10.1",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dependency-cruiser": "18.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
